# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_1=gpt-4
OPENAI_MODEL_2=gpt-3.5-turbo

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL_1=claude-3-5-sonnet-20241022
ANTHROPIC_MODEL_2=claude-3-haiku-20240307

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# Mistral Configuration
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-large-latest

# Ollama Configuration (Local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
DATABASE_PATH=~/.chatmux/conversations.db
PROMPT_LIBRARY_PATH=~/.chatmux/prompts.json

# UI Settings
THEME=dark
GRID_LAYOUT=2x3
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2000

# Network Settings
MODEL_TIMEOUT=30
RETRY_ATTEMPTS=3
RETRY_DELAY=1.0